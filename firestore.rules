rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc(request.auth.uid).data.role == "admin";
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function canAccessConversation(participants) {
      return isSignedIn() && request.auth.uid in participants;
    }

    function validConversationParticipants(participants) {
      return participants is list
        && participants.size() == 2
        && participants[0] is string
        && participants[1] is string
        && participants[0] != participants[1];
    }

    function sameParticipants(firstParticipants, secondParticipants) {
      return validConversationParticipants(firstParticipants)
        && validConversationParticipants(secondParticipants)
        && firstParticipants[0] in secondParticipants
        && firstParticipants[1] in secondParticipants
        && secondParticipants[0] in firstParticipants
        && secondParticipants[1] in firstParticipants;
    }

    function conversationParticipants(conversationId) {
      return get(
        /databases/$(database)/documents/chatConversations/$(conversationId)
      ).data.participants;
    }

    function canReadMessageConversation(conversationId) {
      return canAccessConversation(conversationParticipants(conversationId));
    }

    function canManageMessage(messageData) {
      return isSignedIn()
        && (
          messageData.senderId == request.auth.uid
          || isAdmin()
        );
    }

    function validMessageUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "text",
        "editedAt"
      ]);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /dashboardConfig/{pageId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /chatConversations/{conversationId} {
      allow read: if canAccessConversation(resource.data.participants);

      allow create: if canAccessConversation(request.resource.data.participants)
        && validConversationParticipants(request.resource.data.participants)
        && request.resource.data.lastMessageSenderId == request.auth.uid;

      allow update: if canAccessConversation(resource.data.participants)
        && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if canReadMessageConversation(conversationId);

        allow create: if canAccessConversation(
            getAfter(/databases/$(database)/documents/chatConversations/$(conversationId)).data.participants
          )
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.recipientId in getAfter(/databases/$(database)/documents/chatConversations/$(conversationId)).data.participants;

        allow update: if canReadMessageConversation(conversationId)
          && canManageMessage(resource.data)
          && validMessageUpdate();

        allow delete: if canReadMessageConversation(conversationId)
          && canManageMessage(resource.data);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
